{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "package-name": "andamp-source-librespot",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "app/build.gradle.kts"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "New" },
        { "type": "change", "section": "Changed" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Faster" },
        { "type": "revert", "section": "Reverted" },
        { "type": "refactor", "section": "Internal", "hidden": true },
        { "type": "docs", "section": "Internal", "hidden": true },
        { "type": "chore", "section": "Internal", "hidden": true },
        { "type": "build", "section": "Internal", "hidden": true },
        { "type": "test", "section": "Internal", "hidden": true }
      ]
    }
  }
}
