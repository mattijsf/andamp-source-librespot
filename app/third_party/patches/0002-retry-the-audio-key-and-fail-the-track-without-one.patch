     pub async fn request(&self, track: SpotifyId, file: FileId) -> Result<AudioKey, Error> {
+        // AndAmp: ask again on a timeout. One request had one chance of 1.5s,
+        // and a key that arrives late is indistinguishable from one that never
+        // comes - so a single slow round trip lost the whole track. See
+        // third_party/PATCHES.md.
+        const ATTEMPTS: usize = 3;
+        let mut last = None;
+        for attempt in 1..=ATTEMPTS {
+            match self.request_once(track, file).await {
+                Ok(key) => return Ok(key),
+                Err(e) => {
+                    warn!("Audio key attempt {attempt} of {ATTEMPTS} failed: {e}");
+                    last = Some(e);
+                }
+            }
+        }
+        Err(last.unwrap_or_else(|| AudioKeyError::Timeout.into()))
+    }
